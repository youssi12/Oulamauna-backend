generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model bibliography {
  bibliography_id Int       @id @default(autoincrement())
  scholar_id      Int?
  title           String?   @db.VarChar(255)
  citation        String?   @db.Text
  url             String?   @db.VarChar(255)
  created_by      Int?
  created_at      DateTime? @db.Timestamp(0)
  scholars        scholars? @relation(fields: [scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "bibliography_ibfk_1")
  users           users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bibliography_ibfk_2")

  @@index([created_by], map: "created_by")
  @@index([scholar_id], map: "scholar_id")
}

model blog_comments {
  comment_id Int         @id @default(autoincrement())
  post_id    Int?
  user_id    Int?
  content    String?     @db.Text
  created_at DateTime?   @db.Timestamp(0)
  deleted_at DateTime?   @db.Timestamp(0)
  blog_posts blog_posts? @relation(fields: [post_id], references: [post_id], onDelete: NoAction, onUpdate: NoAction, map: "blog_comments_ibfk_1")
  users      users?      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "blog_comments_ibfk_2")

  @@index([post_id], map: "post_id")
  @@index([user_id], map: "user_id")
}

model blog_posts {
  post_id       Int                @id @default(autoincrement())
  author_id     Int?
  title         String?            @db.VarChar(255)
  content       String?            @db.Text
  status        blog_posts_status?
  created_at    DateTime?          @db.Timestamp(0)
  blog_comments blog_comments[]
  users         users?             @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "blog_posts_ibfk_1")

  @@index([author_id], map: "author_id")
}

// NEW
model comments {
  comment_id       Int               @id @default(autoincrement())
  version_id       Int?
  user_id          Int?
  content          String?           @db.Text
  created_at       DateTime?         @db.Timestamp(0)
  edited_at        DateTime?         @db.Timestamp(0)
  deleted_at       DateTime?         @db.Timestamp(0)
  scholar_versions scholar_versions? @relation(fields: [version_id], references: [version_id], onDelete: Cascade, map: "comments_ibfk_1")
  users            users?            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "comments_ibfk_2")

  @@index([version_id], map: "version_id")
  @@index([user_id], map: "user_id")
}

 

 model disciplines {
  discipline_id       Int                   @id @default(autoincrement())
  name                String                @db.VarChar(255)
  language_id         Int?
  created_at          DateTime?             @db.Timestamp(0)
  languages            languages?            @relation(fields: [language_id], references: [language_id], onDelete: NoAction, onUpdate: NoAction, map: "disciplines_ibfk_1")
  scholar_disciplines scholar_disciplines[]

  @@index([language_id], map: "language_id")
}

model email_verifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @db.VarChar(255)
  expires_at DateTime @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "email_verifications_ibfk_1")

  @@index([user_id], map: "user_id")
}

model internal_links {
  link_id           Int               @id @default(autoincrement())
  source_version_id Int?
  target_scholar_id Int?
  scholar_versions  scholar_versions? @relation(fields: [source_version_id], references: [version_id], onDelete: NoAction, onUpdate: NoAction, map: "internal_links_ibfk_1")
  scholars          scholars?         @relation(fields: [target_scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "internal_links_ibfk_2")

  @@index([source_version_id], map: "source_version_id")
  @@index([target_scholar_id], map: "target_scholar_id")
}

model languages {
  language_id      Int                 @id @default(autoincrement())
  code             String?             @db.VarChar(255)
  name             String?             @db.VarChar(255)

  scholar_versions scholar_versions[]
  disciplines      disciplines[]
  regions          regions[]
}

 model media {
  media_id      Int               @id @default(autoincrement())
  previous_media_id Int?
  version_id    Int

  scholar_versions scholar_versions @relation(fields: [version_id], references: [version_id], onDelete: NoAction, onUpdate: NoAction, map: "media_ibfk_1")
  file_name     String?           @db.VarChar(255)
  file_path     String?           @db.VarChar(500)
  media_url     String?           @db.VarChar(500)

  source_type   media_source_type @default(upload)
  file_type     media_file_type?
  status        media_status?

  uploaded_by Int?

users users? @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_ibfk_2")

  uploaded_at   DateTime?         @db.Timestamp(0)
  view_count    Int               @default(0)
  like_count    Int               @default(0)

  title         String?           @db.VarChar(255)
  year          Int?
  description   String?           @db.Text

  @@index([version_id], map: "version_id")
  @@index([uploaded_by], map: "uploaded_by")
}

model notifications {
  notification_id Int                 @id @default(autoincrement())
  user_id         Int?
  type            notifications_type?
  message         String?             @db.Text
  related_entity  String?             @db.VarChar(255)
  is_read         Boolean?
  created_at      DateTime?           @db.Timestamp(0)
  users           users?              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notifications_ibfk_1")

  @@index([user_id], map: "user_id")
}

model password_resets {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique(map: "token") @db.VarChar(255)
  expires_at DateTime @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_resets_ibfk_1")

  @@index([user_id], map: "user_id")
}

model reports {
  report_id    Int                   @id @default(autoincrement())
  reporter_id  Int?
  content_type reports_content_type?
  content_id   Int?
  reason       String?               @db.Text
  status       String?               @db.VarChar(255)
  created_at   DateTime?             @db.Timestamp(0)
  users        users?                @relation(fields: [reporter_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reports_ibfk_1")

  @@index([reporter_id], map: "reporter_id")
}

 

model roles {
  role_id   Int     @id @default(autoincrement())
  role_name String? @unique(map: "role_name") @db.VarChar(255)
  users     users[]
}

model scholar_aliases {
  alias_id         Int               @id @default(autoincrement())
  version_id       Int?
  alias_name       String?           @db.VarChar(255)
  scholar_versions scholar_versions? @relation(fields: [version_id], references: [version_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_aliases_ibfk_1")

  @@index([version_id], map: "version_id")
}

model scholar_contributors {
  scholar_id Int
  user_id    Int
  scholars   scholars @relation(fields: [scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_contributors_ibfk_1")
  users      users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_contributors_ibfk_2")

  @@id([scholar_id, user_id])
  @@index([user_id], map: "user_id")
}

// NEW
model scholar_disciplines {
  version_id    Int
  discipline_id Int
  disciplines      disciplines      @relation(fields: [discipline_id], references: [discipline_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_disciplines_ibfk_1")
  scholar_versions scholar_versions @relation(fields: [version_id], references: [version_id], onDelete: Cascade, map: "scholar_disciplines_ibfk_2")

  @@id([version_id, discipline_id])
  @@index([discipline_id], map: "discipline_id")
  @@index([version_id], map: "version_id")
}

model scholar_relationships {
  relation_id                                                 Int                                  @id @default(autoincrement())
  scholar_id                                                  Int?
  related_scholar_id                                          Int?
  relation_type                                               scholar_relationships_relation_type?
  scholars_scholar_relationships_scholar_idToscholars         scholars?                            @relation("scholar_relationships_scholar_idToscholars", fields: [scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_relationships_ibfk_1")
  scholars_scholar_relationships_related_scholar_idToscholars scholars?                            @relation("scholar_relationships_related_scholar_idToscholars", fields: [related_scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_relationships_ibfk_2")

  @@index([related_scholar_id], map: "related_scholar_id")
  @@index([scholar_id], map: "scholar_id")
}

model scholar_versions {
  version_id          Int                      @id @default(autoincrement())
  scholar_id          Int?
  language_id         Int?
  canonical_name      String?                  @db.VarChar(255)

  region_id           Int?
  regions             regions?                @relation(fields: [region_id], references: [region_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_versions_ibfk_4")

  century_hijri_start     Int?
  century_hijri_end       Int?
  century_gregorian_start Int?
  century_gregorian_end   Int?
  biography               String?              @db.Text

  // CURRENT APPROVED IMAGE
  image_url           String?                  @db.VarChar(500)
  image_status        media_status?

  // Who uploaded the currently stored image
  image_uploaded_by   Int?

  status              scholar_versions_status?
  created_by          Int?
  created_at          DateTime?                @db.Timestamp(0)

  internal_links      internal_links[]
  version_type        scholar_versions_type     @default(creation)
  scholar_aliases     scholar_aliases[]

  scholars            scholars?                @relation(fields: [scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_versions_ibfk_1")
  languages           languages?               @relation(fields: [language_id], references: [language_id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_versions_ibfk_2")
  users               users?                   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "scholar_versions_ibfk_3")

  scholar_references scholar_references[]
  scholar_works      scholar_works[]
  media              media[]
  scholar_dates      scholar_dates[]
  scholar_disciplines scholar_disciplines[]
  comments            comments[]

  img_versions       img_versions[]

  @@index([created_by], map: "created_by")
  @@index([language_id], map: "language_id")
  @@index([scholar_id], map: "scholar_id")
  @@index([region_id], map: "region_id")
}


model img_versions {
  img_version_id Int @id @default(autoincrement())

  version_id    Int
  image_url     String       @db.VarChar(500)

  status        media_status @default(pending)

  uploaded_by   Int
  created_at    DateTime?    @db.Timestamp(0)

  scholar_versions scholar_versions @relation(fields: [version_id], references: [version_id], onDelete: NoAction, onUpdate: NoAction)
  users            users            @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([version_id])
  @@index([uploaded_by])
  @@index([status])
}

 model scholar_references {
  reference_id Int @id @default(autoincrement())
  version_id   Int
  created_by     Int?  
  previous_reference_id Int?

  title        String? @db.VarChar(255)
  citation     String? @db.Text
  url          String? @db.VarChar(500)
  status media_status @default(pending)

  scholar_versions scholar_versions @relation(fields: [version_id], references: [version_id], onDelete: Cascade)
  users            users?           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([version_id])
}


model scholars {
  scholar_id                                                               Int                     @id @default(autoincrement())
  created_by                                                               Int?
  created_at                                                               DateTime?               @db.Timestamp(0)
  bibliography                                                             bibliography[]
  internal_links                                                           internal_links[]
  
  scholar_contributors                                                     scholar_contributors[]
  scholar_relationships_scholar_relationships_scholar_idToscholars         scholar_relationships[] @relation("scholar_relationships_scholar_idToscholars")
  scholar_relationships_scholar_relationships_related_scholar_idToscholars scholar_relationships[] @relation("scholar_relationships_related_scholar_idToscholars")
  scholar_versions                                                         scholar_versions[]
  users                                                                    users?                  @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "scholars_ibfk_1")

  @@index([created_by], map: "created_by")
}

model users {
  id                   Int                    @id @default(autoincrement())
  username             String?                @unique(map: "username") @db.VarChar(255)
  email                String?                @unique(map: "email") @db.VarChar(255)
  password_hash        String?                @db.VarChar(255)
  role_id              Int?                   @default(3)
  is_banned            Boolean?               @default(false)
  created_at           DateTime?              @db.Timestamp(0)
  email_verified       Boolean                @default(false)
  bibliography         bibliography[]
  blog_comments        blog_comments[]
  blog_posts           blog_posts[]
  comments             comments[]
  email_verifications  email_verifications[]
  media                media[]
  notifications        notifications[]
  password_resets      password_resets[]
  reports              reports[]
  allowed_to_contribute Boolean  @default(true) 
 
  scholar_contributors scholar_contributors[]
  scholar_versions     scholar_versions[]
  scholars             scholars[]
  scholar_works       scholar_works[]
  img_versions        img_versions[]
  scholar_references  scholar_references[]
  roles                roles?                 @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction, map: "users_ibfk_1")

  @@index([role_id], map: "role_id")
}

 model regions {
  region_id        Int                @id @default(autoincrement())
  name             String             @db.VarChar(255)
  language_id      Int
  created_at       DateTime?          @db.Timestamp(0)

  language         languages          @relation(fields: [language_id], references: [language_id])

  scholar_versions scholar_versions[]
}

enum scholar_date_type {
  birth
  death
}

enum calendar_type {
  hijri
  gregorian
}

model scholar_dates {
  date_id        Int               @id @default(autoincrement())
  version_id     Int
  date_type      scholar_date_type
  calendar       calendar_type
  year           Int?              // structured year — enables filtering/sorting/century derivation
  is_approximate Boolean           @default(false) // "circa" flag
  raw_text       String?           @db.VarChar(100) // fallback display, e.g. "early 4th century" or "disputed"

  scholar_versions scholar_versions @relation(fields: [version_id], references: [version_id], onDelete: Cascade)

  @@unique([version_id, date_type, calendar])
  @@index([version_id])
}


 enum notifications_type {
  NEW_SCHOLAR_SUBMISSION
  EDIT_PROPOSAL
  REPORT_SUBMITTED
  COMMENT_ON_BLOG
  COMMENT_ON_SCHOLAR
  SCHOLAR_APPROVED
  SCHOLAR_REJECTED
  MEDIA_APPROVED
  MEDIA_REJECTED
  IMAGE_APPROVED
  IMAGE_REJECTED
  WORK_APPROVED
  WORK_REJECTED
  REFERENCE_APPROVED
  REFERENCE_REJECTED
  NEW_DISCIPLINE_SUBMISSION
  NEW_REGION_SUBMISSION
}
model scholar_works {
  work_id        Int                @id @default(autoincrement())
  version_id     Int
  created_by   Int?  
  previous_work_id Int?

  title          String             @db.VarChar(255)
  year           Int?
  format         work_format
  description    String?            @db.Text

  media_url      String?            @db.VarChar(500)
  file_name      String?            @db.VarChar(255)
  file_path      String?            @db.VarChar(500)
  source_type    media_source_type?
  status media_status @default(pending)

  scholar_versions scholar_versions @relation(fields: [version_id], references: [version_id], onDelete: Cascade)
   users            users?           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([version_id])
}

    


enum reports_content_type {
  scholar
  comment
  blog_post
  blog_comment
}

enum scholar_relationships_relation_type {
  teacher
  student
}

enum blog_posts_status {
  draft
  published
}

enum media_file_type {
  pdf
  audio
  video
}

enum media_status {
  pending
  approved
  rejected 
   superseded
}

enum scholar_versions_status {
  pending
  approved
  rejected
  superseded
}

 
 enum scholar_versions_type {
  creation
  edition
}

enum media_source_type {
  upload
  external
}


 enum work_format {
  BOOK
  ARTICLE
  TREATISE
  MANUSCRIPT
  LECTURE
  SERMON
  FATWA
  POEM
  LETTER
  COMMENTARY
  TRANSLATION
  RESEARCH
  COURSE
  DEVICE
  INVENTION
  SOFTWARE
  MAP
  OTHER
}