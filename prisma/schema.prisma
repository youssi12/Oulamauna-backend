generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model contact_messages {
  id          Int                    @id @default(autoincrement())
  name        String                 @db.VarChar(255)
  email       String                 @db.VarChar(255)
  subject     String?                @db.VarChar(255)
  message     String                 @db.Text
  status      contact_message_status @default(pending)
  created_at  DateTime               @default(now()) @db.Timestamp(0)
  updated_at  DateTime?              @db.Timestamp(0)
  replied_at  DateTime?              @db.Timestamp(0)
  admin_reply String?                @db.Text
  admin_note  String?                @db.Text

  @@index([status])
  @@index([created_at])
  @@index([email])
}

model disciplines {
  discipline_id Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  image_url     String?   @db.VarChar(500)
  translations  Json?
  created_at    DateTime? @db.Timestamp(0)
}

model email_verifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamp(0)

  @@index([user_id], map: "user_id")
}

model languages {
  language_id Int     @id @default(autoincrement())
  code        String? @db.VarChar(255)
  name        String? @db.VarChar(255)
}

model media {
  media_id          Int               @id @default(autoincrement())
  previous_media_id Int?
  version_id        Int
  file_name         String?           @db.VarChar(255)
  file_path         String?           @db.VarChar(500)
  media_url         String?           @db.VarChar(500)
  source_type       media_source_type @default(upload)
  file_type         media_file_type?
  status            media_status?
  uploaded_by       Int?
  uploaded_at       DateTime?         @db.Timestamp(0)
  view_count        Int               @default(0)
  like_count        Int               @default(0)
  title             String?           @db.VarChar(255)
  year              Int?
  description       String?           @db.Text

  @@index([version_id], map: "version_id")
  @@index([uploaded_by], map: "uploaded_by")
}

model notifications {
  notification_id Int                 @id @default(autoincrement())
  user_id         Int?
  type            notifications_type?
  message         String?             @db.Text
  related_entity  String?             @db.VarChar(255)
  is_read         Boolean?
  created_at      DateTime?           @db.Timestamp(0)

  @@index([user_id], map: "user_id")
}

model password_resets {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique(map: "token") @db.VarChar(255)
  expires_at DateTime @db.Timestamp(0)

  @@index([user_id], map: "user_id")
}

model reports {
  report_id    Int                   @id @default(autoincrement())
  reporter_id  Int?
  content_type reports_content_type?
  content_id   Int?
  reason       String?               @db.Text
  status       String?               @db.VarChar(255)
  created_at   DateTime?             @db.Timestamp(0)

  @@unique([reporter_id, content_type, content_id])
  @@index([reporter_id], map: "reporter_id")
  @@index([status])
}

model roles {
  role_id   Int     @id @default(autoincrement())
  role_name String? @unique(map: "role_name") @db.VarChar(255)
}

model scholar_aliases {
  alias_id   Int     @id @default(autoincrement())
  version_id Int?
  alias_name String? @db.VarChar(255)

  @@index([version_id], map: "version_id")
}

model scholar_contributors {
  scholar_id Int
  user_id    Int

  @@id([scholar_id, user_id])
  @@index([user_id], map: "user_id")
}

model scholar_disciplines {
  version_id    Int
  discipline_id Int

  @@id([version_id, discipline_id])
  @@index([discipline_id], map: "discipline_id")
  @@index([version_id], map: "version_id")
}

model scholar_relationships {
  relation_id        Int                                  @id @default(autoincrement())
  version_id         Int
  related_version_id Int
  relation_type      scholar_relationships_relation_type?

  @@index([version_id], map: "version_id")
  @@index([related_version_id], map: "related_version_id")
}

model scholar_versions {
  version_id              Int                      @id @default(autoincrement())
  scholar_id              Int?
  language_id             Int?
  canonical_name          String?                  @db.VarChar(255)
  region_id               Int?
  century_hijri_start     Int?
  century_hijri_end       Int?
  century_gregorian_start Int?
  century_gregorian_end   Int?
  biography               String?                  @db.Text
  image_url               String?                  @db.VarChar(500)
  image_status            media_status?
  image_uploaded_by       Int?
  status                  scholar_versions_status?
  created_by              Int?
  created_at              DateTime?                @db.Timestamp(0)
  version_type            scholar_versions_type    @default(creation)

  @@index([created_by], map: "created_by")
  @@index([language_id], map: "language_id")
  @@index([scholar_id], map: "scholar_id")
  @@index([region_id], map: "region_id")
  @@index([status, created_at])
  @@index([scholar_id, language_id, status])
  @@index([status, version_type])
}

model img_versions {
  img_version_id Int          @id @default(autoincrement())
  version_id     Int
  image_url      String       @db.VarChar(500)
  status         media_status @default(pending)
  uploaded_by    Int
  created_at     DateTime?    @db.Timestamp(0)

  @@index([version_id])
  @@index([uploaded_by])
  @@index([status])
}

model scholar_references {
  reference_id          Int          @id @default(autoincrement())
  version_id            Int
  created_by            Int?
  previous_reference_id Int?
  title                 String?      @db.VarChar(255)
  citation              String?      @db.Text
  url                   String?      @db.VarChar(500)
  status                media_status @default(pending)

  @@index([version_id])
  @@index([status])
  @@index([created_by], map: "scholar_references_created_by_fkey")
}

model scholars {
  scholar_id  Int       @id @default(autoincrement())
  created_by  Int?
  created_at  DateTime? @db.Timestamp(0)
  is_featured Boolean   @default(false)

  @@index([created_by], map: "created_by")
  @@index([is_featured])
}

model users {
  id                    Int                      @id @default(autoincrement())
  username              String?                  @unique(map: "username") @db.VarChar(255)
  email                 String?                  @unique(map: "email") @db.VarChar(255)
  password_hash         String?                  @db.VarChar(255)
  role_id               Int?
  is_banned             Boolean?                 @default(false)
  strike_count          Int                      @default(0)
  created_at            DateTime?                @db.Timestamp(0)
  email_verified        Boolean                  @default(false)
  token_version         Int                      @default(0)
  allowed_to_contribute Boolean                  @default(true)
  name                  String?                  @db.VarChar(255)
  bio                   String?                  @db.Text
  profile_picture       String?                  @db.VarChar(500)
  links                 Json?
  contributorBadge      Boolean                  @default(false)
  preferred_language_id Int?                     @default(1)
  notifications_enabled Boolean                  @default(true)
  profile_visibility    profile_visibility_type? @default(public)
  show_email            Boolean                  @default(false)
  show_contributions    Boolean                  @default(true)
  is_active             Boolean                  @default(true)
  deactivated_at        DateTime?                @db.Timestamp(0)

  @@index([role_id], map: "role_id")
  @@index([is_banned, allowed_to_contribute])
  @@index([preferred_language_id], map: "users_preferred_language_id_fkey")
}

model regions {
  region_id    Int       @id @default(autoincrement())
  name         String    @db.VarChar(255)
  translations Json?
  created_at   DateTime? @db.Timestamp(0)
}

model scholar_dates {
  date_id        Int               @id @default(autoincrement())
  version_id     Int
  date_type      scholar_date_type
  calendar       calendar_type
  year           Int?
  is_approximate Boolean           @default(false)
  raw_text       String?           @db.VarChar(100)

  @@unique([version_id, date_type, calendar])
  @@index([version_id])
}

model scholar_works {
  work_id          Int                @id @default(autoincrement())
  version_id       Int
  created_by       Int?
  previous_work_id Int?
  title            String             @db.VarChar(255)
  year             Int?
  format           work_format
  description      String?            @db.Text
  media_url        String?            @db.VarChar(500)
  file_name        String?            @db.VarChar(255)
  file_path        String?            @db.VarChar(500)
  source_type      media_source_type?
  status           media_status       @default(pending)
  is_featured      Boolean            @default(false)

  @@index([version_id])
  @@index([status])
  @@index([created_by], map: "scholar_works_created_by_fkey")
}

model forum_categories {
  category_id   Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  translations  Json?
  description   String?   @db.Text
  display_order Int       @default(0)
  created_at    DateTime? @db.Timestamp(0)
}

model forum_posts {
  post_id     Int       @id @default(autoincrement())
  user_id     Int?
  category_id Int?
  title       String    @db.VarChar(255)
  content     String    @db.Text
  like_count  Int       @default(0)
  is_hidden   Boolean   @default(false)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  deleted_at  DateTime? @db.Timestamp(0)

  @@index([user_id])
  @@index([category_id])
  @@index([deleted_at])
  @@index([is_hidden])
}

model forum_comments {
  comment_id        Int       @id @default(autoincrement())
  post_id           Int
  user_id           Int?
  parent_comment_id Int?
  content           String    @db.Text
  like_count        Int       @default(0)
  is_hidden         Boolean   @default(false)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  deleted_at        DateTime? @db.Timestamp(0)

  @@index([post_id])
  @@index([parent_comment_id])
  @@index([user_id])
  @@index([deleted_at])
}

model forum_post_likes {
  like_id    Int       @id @default(autoincrement())
  post_id    Int
  user_id    Int
  created_at DateTime? @db.Timestamp(0)

  @@unique([post_id, user_id])
  @@index([post_id])
  @@index([user_id], map: "forum_post_likes_user_id_fkey")
}

model forum_comment_likes {
  like_id    Int       @id @default(autoincrement())
  comment_id Int
  user_id    Int
  created_at DateTime? @db.Timestamp(0)

  @@unique([comment_id, user_id])
  @@index([comment_id])
  @@index([user_id], map: "forum_comment_likes_user_id_fkey")
}

model media_likes {
  like_id    Int       @id @default(autoincrement())
  media_id   Int
  user_id    Int
  created_at DateTime? @db.Timestamp(0)

  @@unique([media_id, user_id])
  @@index([media_id])
  @@index([user_id], map: "media_likes_user_id_fkey")
}

enum scholar_date_type {
  birth
  death
}

enum calendar_type {
  hijri
  gregorian
}

enum notifications_type {
  NEW_SCHOLAR_SUBMISSION
  EDIT_PROPOSAL
  REPORT_SUBMITTED
  SCHOLAR_APPROVED
  SCHOLAR_REJECTED
  MEDIA_APPROVED
  MEDIA_REJECTED
  IMAGE_APPROVED
  IMAGE_REJECTED
  WORK_APPROVED
  WORK_REJECTED
  REFERENCE_APPROVED
  REFERENCE_REJECTED
  NEW_DISCIPLINE_SUBMISSION
  NEW_REGION_SUBMISSION
  NEW_FORUM_POST
  COMMENT_ON_POST
  REPLY_TO_COMMENT
}

enum reports_content_type {
  scholar
  comment
  forum_post
  forum_comment
}

enum scholar_relationships_relation_type {
  teacher
  student
}

enum media_file_type {
  pdf
  audio
  video
}

enum media_status {
  pending
  approved
  rejected
  superseded
}

enum scholar_versions_status {
  draft
  pending
  approved
  rejected
  superseded
}

enum scholar_versions_type {
  creation
  edition
}

enum media_source_type {
  upload
  external
}

enum work_format {
  BOOK
  ARTICLE
  TREATISE
  MANUSCRIPT
  LECTURE
  SERMON
  FATWA
  POEM
  LETTER
  COMMENTARY
  TRANSLATION
  RESEARCH
  COURSE
  DEVICE
  INVENTION
  SOFTWARE
  MAP
  OTHER
}

enum profile_visibility_type {
  public
  registered_only
  private
}

enum contact_message_status {
  pending
  read
  replied
  archived
}
