generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model bibliography {
  bibliography_id Int       @id @default(autoincrement())
  scholar_id      Int?
  title           String?   @db.VarChar(255)
  citation        String?   @db.Text
  url             String?   @db.VarChar(255)
  created_by      Int?
  created_at      DateTime? @db.Timestamp(0)
  scholars        scholars? @relation(fields: [scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "bibliography_ibfk_1")
  users           users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "bibliography_ibfk_2")

  @@index([created_by], map: "created_by")
  @@index([scholar_id], map: "scholar_id")
}

model blog_comments {
  comment_id Int         @id @default(autoincrement())
  post_id    Int?
  user_id    Int?
  content    String?     @db.Text
  created_at DateTime?   @db.Timestamp(0)
  deleted_at DateTime?   @db.Timestamp(0)
  blog_posts blog_posts? @relation(fields: [post_id], references: [post_id], onDelete: NoAction, onUpdate: NoAction, map: "blog_comments_ibfk_1")
  users      users?      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "blog_comments_ibfk_2")

  @@index([post_id], map: "post_id")
  @@index([user_id], map: "user_id")
}

model blog_posts {
  post_id       Int                @id @default(autoincrement())
  author_id     Int?
  title         String?            @db.VarChar(255)
  content       String?            @db.Text
  status        blog_posts_status?
  created_at    DateTime?          @db.Timestamp(0)
  blog_comments blog_comments[]
  users         users?             @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "blog_posts_ibfk_1")

  @@index([author_id], map: "author_id")
}

model comments {
  comment_id Int       @id @default(autoincrement())
  scholar_id Int?
  user_id    Int?
  content    String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  edited_at  DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  scholars   scholars? @relation(fields: [scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "comments_ibfk_1")
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "comments_ibfk_2")

  @@index([scholar_id], map: "scholar_id")
  @@index([user_id], map: "user_id")
}

model discipline_translations {
  translation_id Int          @id @default(autoincrement())
  discipline_id  Int?
  language_id    Int?
  name           String?      @db.VarChar(255)
  disciplines    disciplines? @relation(fields: [discipline_id], references: [discipline_id], onDelete: NoAction, onUpdate: NoAction, map: "discipline_translations_ibfk_1")
  languages      languages?   @relation(fields: [language_id], references: [language_id], onDelete: NoAction, onUpdate: NoAction, map: "discipline_translations_ibfk_2")

  @@index([discipline_id], map: "discipline_id")
  @@index([language_id], map: "language_id")
}

model disciplines {
  discipline_id           Int                       @id @default(autoincrement())
  created_at              DateTime?                 @db.Timestamp(0)
  discipline_translations discipline_translations[]
  scholar_disciplines     scholar_disciplines[]
}

model email_verifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @db.VarChar(255)
  expires_at DateTime @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "email_verifications_ibfk_1")

  @@index([user_id], map: "user_id")
}

model internal_links {
  link_id           Int               @id @default(autoincrement())
  source_version_id Int?
  target_scholar_id Int?
  scholar_versions  scholar_versions? @relation(fields: [source_version_id], references: [version_id], onDelete: NoAction, onUpdate: NoAction, map: "internal_links_ibfk_1")
  scholars          scholars?         @relation(fields: [target_scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "internal_links_ibfk_2")

  @@index([source_version_id], map: "source_version_id")
  @@index([target_scholar_id], map: "target_scholar_id")
}

model languages {
  language_id             Int                       @id @default(autoincrement())
  code                    String?                   @db.VarChar(255)
  name                    String?                   @db.VarChar(255)
  discipline_translations discipline_translations[]
  scholar_versions        scholar_versions[]
}

model media {
  media_id    Int              @id @default(autoincrement())
  scholar_id  Int?
  file_name   String?          @db.VarChar(255)
  file_path   String?          @db.VarChar(255)
  media_url     String?          @db.VarChar(500)
  source_type   media_source_type @default(upload)
  file_type   media_file_type?
  status      media_status?
  uploaded_by Int?
  uploaded_at DateTime?        @db.Timestamp(0)
  view_count Int @default(0)
  like_count Int @default(0)
  scholars    scholars?        @relation(fields: [scholar_id], references: [scholar_id], onDelete: NoAction, onUpdate: NoAction, map: "media_ibfk_1")
  users       users?           @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "media_ibfk_2")
  title         String?            @db.VarChar(255)
 // format        media_format? -->thiis 
 // author        String?            @db.VarChar(255)  ->this
 // publisher     String?            @db.VarChar(255)--->this 
  year          Int?
  description   String?            @db.Text

  @@index([scholar_id], map: "scholar_id")
  @@index([uploaded_by], map: "uploaded_by")
}

model notifications {
  notification_id Int                 @id @default(autoincrement())
  user_id         Int?
  type            notifications_type?
  message         String?             @db.Text
  related_entity  String?             @db.VarChar(255)
  is_read         Boolean?
  created_at      DateTime?           @db.Timestamp(0)
  users           users?              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "notifications_ibfk_1")

  @@index([user_id], map: "user_id")
}

model password_resets {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique(map: "token") @db.VarChar(255)
  expires_at DateTime @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_resets_ibfk_1")

  @@index([user_id], map: "user_id")
}

model reports {
  report_id    Int                   @id @default(autoincrement())
  reporter_id  Int?
  content_type reports_content_type?
  content_id   Int?
  reason       String?               @db.Text
  status       String?               @db.VarChar(255)
  created_at   DateTime?             @db.Timestamp(0)
  users        users?                @relation(fields: [reporter_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reports_ibfk_1")

  @@index([reporter_id], map: "reporter_id")
}

